# Copy to api/.env (gitignored). Loaded by application.properties.
DB_URL=jdbc:mysql://localhost:3306/coogpath
DB_USERNAME=root
DB_PASSWORD=

# Comma-separated origins allowed to call the API. Defaults to "*".
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Set to true to log every SQL statement.
SHOW_SQL=false

# Signs sign-in tokens. Generate with: openssl rand -base64 48
# Leave unset locally to use a random key (sign-ins then end on restart).
JWT_SECRET=
# How long a sign-in lasts, e.g. 12h or 7d.
JWT_TTL=7d

# Plan cache: "caffeine" (in-process, default) or "redis" (requires REDIS_URL).
CACHE_TYPE=caffeine
REDIS_URL=redis://localhost:6379

# Per-IP request limits. Only trust X-Forwarded-For behind a proxy that sets it.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_TRUST_PROXY=false
